# The web server of production: the compiled site, the API behind /api, and HTTPS.
#
# Behind the organisation's login proxy (the normal case) that proxy does the HTTPS and the sign-in,
# and puts the email of the person in a header. The API believes that header, so ONLY the proxy may
# talk to this server: PROXY_IPS (in .env) lists its addresses, and anybody else gets a 403. It also
# says whose X-Forwarded-For (the visitor's address) can be believed.
#
# SITE_ADDRESS (in .env) is what people type:
#   - ":80" (the default): plain HTTP, the proxy in front does the HTTPS;
#   - a domain name, e.g. budget.example.org: Caddy gets and renews the HTTPS certificate by itself
#     (ports 80 and 443 must reach this container), for signing in with Google and no proxy; then
#     PROXY_IPS is "0.0.0.0/0 ::/0" (everybody) and the visitor's own address is not believed.
{
	servers {
		trusted_proxies static {$PROXY_IPS}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# first of the handle blocks, so that nothing below is reached by anybody else
	@outsiders not remote_ip {$PROXY_IPS}
	handle @outsiders {
		# it says which address it saw, so that PROXY_IPS can be set without guessing
		respond "Forbidden (your address: {remote_host})" 403
	}

	# The API sets its own security headers; here only the forwarding.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Everything else is the site. The pages are drawn by the browser, so any address that is not a
	# file (/budget/hw) must get index.html.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			# only meaningful over HTTPS; browsers ignore it on plain HTTP
			Strict-Transport-Security "max-age=31536000"
		}
		# index.html and the pages always revalidate; the files in /assets have a hash in their name,
		# so they never change and can be kept for good
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
	}
}

{
  "name": "simple-configurable-erp",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @erp/api db:generate",
    "db:migrate": "pnpm --filter @erp/api db:migrate",
    "db:seed": "pnpm --filter @erp/api db:seed",
    "db:roles": "pnpm --filter @erp/api db:roles",
    "db:seed-demo": "pnpm --filter @erp/api db:seed-demo",
    "reconcile": "pnpm --filter @erp/import-xlsx reconcile"
  }
}

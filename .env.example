# Copy to .env for local development. These are development-only defaults for the
# local Postgres container; never reuse them anywhere that is reachable from a network.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp

# Used by the API and tools when run on the host (Docker Compose overrides it with the "db" host).
DATABASE_URL=postgres://erp:erp_dev_password@localhost:5432/erp

# --- Login ---------------------------------------------------------------------------------------
# Signs the session token (24 h). At least 32 characters. Changing it signs everybody out.
# In production use a long random value, e.g.  openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-it-in-production-0123456789
# The address people type (where Google sends them back after signing in).
PUBLIC_URL=http://localhost:5173
# Emails that are always admin. The first admin; also the way back in if everybody was demoted.
ADMIN_EMAILS=dev@localhost.test
# Development only: "Sign in as developer" without Google. The server refuses to start in
# production while this is set.
DEV_LOGIN_EMAIL=dev@localhost.test

# Google sign-in (from Google Cloud Console, see docs/accesso-e-storico.md). Leave empty in
# development to use the developer login above; all three are required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only accounts of this Google Workspace domain can sign in, e.g. example.org
GOOGLE_ALLOWED_DOMAIN=

# Copy to .env for local development. These are development-only defaults for the
# local Postgres container; never reuse them anywhere that is reachable from a network.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp

# Used by the API and tools when run on the host (Docker Compose overrides it with the "db" host).
DATABASE_URL=postgres://erp:erp_dev_password@localhost:5432/erp

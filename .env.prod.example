# Copy to ".env" next to docker-compose.prod.yml ON THE SERVER (permissions 600) and fill it in.
# Never commit the real file and never reuse the values of .env.example.
#
# Passwords go inside database addresses: use letters and digits only, e.g.  openssl rand -hex 24

# Which version to run: a tag of the repository without the "v" (0.1.0), or "latest".
ERP_VERSION=latest

# What people type. A domain name gets HTTPS by itself; ":80" is plain HTTP (when another program
# in front does the HTTPS, see docs/rilascio.md).
SITE_ADDRESS=budget.example.org
# The same address, with https:// (where Google sends people back after signing in).
PUBLIC_URL=https://budget.example.org

# Database: the owner of the tables (migrations only) and the API's own user "erp_app".
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=erp
APP_DB_PASSWORD=change-me-api-password

# Signs the session token (24 h), at least 32 characters:  openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-random-text
# Emails that are always admin: the first admin, and the way back in.
ADMIN_EMAILS=treasurer@example.org

# Google sign-in (docs/accesso-e-storico.md): required in production.
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-google-secret
GOOGLE_ALLOWED_DOMAIN=example.org

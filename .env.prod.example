# Copy to ".env" next to docker-compose.prod.yml ON THE SERVER (permissions 600) and fill it in.
# Never commit the real file and never reuse the values of .env.example.
#
# Passwords go inside database addresses: use letters and digits only, e.g.  openssl rand -hex 24

# Which version to run: the tag of the release without the "v" (0.1.0), or "latest".
ERP_VERSION=latest

# --- Signed in by the organisation's login proxy ---------------------------------------------------
# The proxy does the HTTPS and the sign-in, and sends the email of the person in this header. The API
# believes it, so only the proxy may reach the server: PROXY_IPS lists its addresses (or ranges),
# separated by spaces; anybody else gets a 403. Ask IT which ones, and check in "docker compose logs web"
# that the address Caddy sees is one of them.
TRUSTED_EMAIL_HEADER=X-Email
PROXY_IPS=10.0.0.5
# Plain HTTP: the proxy in front does the HTTPS.
SITE_ADDRESS=:80
# The address of this server that the proxy reaches (127.0.0.1 when the proxy runs on this same server).
WEB_BIND=0.0.0.0
# What people type: the address of the proxy, with https:// (the app uses it to recognise its own pages).
PUBLIC_URL=https://budget.example.org

# --- Database: the owner of the tables (migrations only) and the API's own user "erp_app" ----------
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=erp
APP_DB_PASSWORD=change-me-api-password

# Emails that are always admin: the first admin, and the way back in.
ADMIN_EMAILS=treasurer@example.org

# --- Instead of the proxy: sign in with Google (docs/accesso-e-storico.md) --------------------------
# Leave TRUSTED_EMAIL_HEADER empty, set SITE_ADDRESS to a domain (HTTPS by itself), PROXY_IPS to
# "0.0.0.0/0 ::/0", and fill in these four:
# JWT_SECRET=         # signs the session, at least 32 characters:  openssl rand -base64 48
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAIN=example.org

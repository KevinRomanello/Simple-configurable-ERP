{
  "name": "@erp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:roles": "tsx --env-file-if-exists=../../.env src/db/roles.ts",
    "db:seed-demo": "tsx --env-file-if-exists=../../.env src/db/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@erp/calc": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "exports": {
    "./lookups": "./src/modules/lookups/lookups.service.ts",
    "./seasons": "./src/modules/seasons/seasons.service.ts",
    "./db": "./src/db/client.ts",
    "./schema": "./src/db/schema.ts",
    "./money": "./src/core/money.ts",
    "./snapshot": "./src/snapshot.ts"
  }
}
